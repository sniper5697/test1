[Unit]
Description=Velora Voice Staging
After=network.target

[Service]
Type=simple
User=cbk
WorkingDirectory=/home/cbk/apps/velora-voice/staging/current
Environment=HOME=/home/cbk
Environment=NODE_ENV=production
Environment=PORT=3100
ExecStart=/bin/bash -lc 'export NVM_DIR="$HOME/.nvm"; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"; npm start -- --hostname 0.0.0.0 --port 3100'
Restart=always
RestartSec=5
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
